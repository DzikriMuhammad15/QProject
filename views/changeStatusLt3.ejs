<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="https://unpkg.com/boxicons@2.0.9/css/boxicons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/stylesheets/changeStatusLt3Style.css" />
    <title>Qurban</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Firebase SDK v8 (Realtime Database SAJA - tanpa Storage) -->
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>
    <link rel="stylesheet" href="/stylesheets/loading.css" />
  </head>
  <body>
  <div id="loadingOverlay"><div class="loading-spinner"></div><p class="loading-text">Memproses...</p></div>
  <script src="/scripts/loading.js"></script>
    <section id="sidebar">
      <a href="#" class="brand">
        <img 
            src="/img/logo_nur_shofa.jpeg" 
            alt="Logo Qurban"
            style="width:35px; height:35px; object-fit:contain; margin-right:10px;"
        >
        Qurban</a>
      <ul class="side-menu">
        <li><a href="/panitLt3"><i class="bx bxs-dashboard icon"></i> Dashboard</a></li>
        <li class="divider" data-text="main">Main</li>
        <li><a href="#" class="active"><i class="bx bxs-chart icon"></i> Change Status</a></li>
        <li><a href="/panitLt3/revertDeliver"><i class="bx bxs-chart icon"></i> Revert Deliver</a></li>
        <li><a href="/panitLt3/revertPostpone"><i class="bx bxs-chart icon"></i> Revert Postpone</a></li>
      </ul>
    </section>

    <section id="content">
      <nav>
        <i class="bx bx-menu toggle-sidebar"></i>
        <form action="#"></form>
        <span class="divider"></span>
        <div class="profile">
          <img src="/img/people.png" alt="" />
          <ul class="profile-link">
            <li><a data-bs-toggle="modal" data-bs-target="#modalLogout"><i class="bx bxs-log-out-circle"></i> Logout</a></li>
          </ul>
        </div>
      </nav>
      <main>
        <ul class="breadcrumbs">
          <li><a href="#">Home</a></li>
          <li class="divider">/</li>
          <li><a href="#" class="active">Dashboard</a></li>
          <li class="divider">/</li>
          <li><a href="#" class="active">Change Status</a></li>
        </ul>

        <!-- Tab Sapi / Kambing -->
        <div class="d-flex gap-2 mb-3">
          <button class="btn btn-primary" id="tabSapi" onclick="switchTab('sapi')">
            <i class="fa-solid fa-cow me-1"></i> Sapi
          </button>
          <button class="btn btn-outline-success" id="tabKambing" onclick="switchTab('kambing')">
            <i class="fa-solid fa-hippo me-1"></i> Kambing
          </button>
        </div>

        <div class="info-data">
          <section class="section" id="explore"></section>
        </div>
      </main>
    </section>

    <!-- Modal Logout -->
    <div class="modal fade" id="modalLogout" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header"><h1 class="modal-title fs-5">Logout</h1></div>
          <div class="modal-body">Are you sure want to logout?</div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Back</button>
            <a href="/auth/logout"><button type="button" class="btn btn-danger">Logout</button></a>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
    <script src="/scripts/changeStatusLt3Script.js"></script>
    <script>
      var firebaseConfig = <%- JSON.stringify(firebaseConfig) %>;
      firebase.initializeApp(firebaseConfig);
      const database = firebase.database();

      let currentTab = 'sapi';
      let activeListener = null;
      let activeRef = null;

      // ─── Tab Switch ────────────────────────────────────────────────
      function switchTab(tab) {
        currentTab = tab;
        document.getElementById('tabSapi').className =
          tab === 'sapi' ? 'btn btn-primary' : 'btn btn-outline-primary';
        document.getElementById('tabKambing').className =
          tab === 'kambing' ? 'btn btn-success' : 'btn btn-outline-success';

        // Cabut listener lama
        if (activeRef && activeListener) {
          activeRef.off('value', activeListener);
          activeListener = null;
        }
        document.getElementById('explore').innerHTML = '';
        document.querySelectorAll('.modal-dinamis').forEach(el => el.remove());

        listenHewan(tab);
      }

      // ─── Transform Data ────────────────────────────────────────────
            // ── Cache helper: fetch mudhohis + users SEKALI, lookup dari map ──
      async function fetchMudhohiCache() {
        const [mudhohisSnap, usersSnap] = await Promise.all([
          database.ref("mudhohis/").once("value"),
          database.ref("users/").once("value")
        ]);
        const mudhohisData = mudhohisSnap.val() || {};
        const usersData    = usersSnap.val() || {};
        const mudhohiNameMap = {};
        for (const uid in usersData) {
          const u = usersData[uid];
          if (u.mudhohiId) mudhohiNameMap[u.mudhohiId] = u.name || null;
        }
        return { mudhohisData, mudhohiNameMap };
      }

      async function transformHewanData(hewanData, jenis) {
        const result = [];
        const { mudhohisData, mudhohiNameMap } = await fetchMudhohiCache();
        for (const idHewan in hewanData) {
          const hewan = hewanData[idHewan];
          const hewanObj = { idHewan, jenis, foto: hewan.foto, state: hewan.state, mudhohi: [] };
          for (const key in hewan) {
            if (key !== 'foto' && key !== 'state' && typeof hewan[key] === 'object') {
              hewanObj.mudhohi.push({
                idMudhohi: key, ...(mudhohisData[key] || {}), name: mudhohiNameMap[key] || null,
                isDelivered: hewan[key].isDelivered, isPostponed: hewan[key].isPostponed,
                bukti: hewan[key].bukti, noHewan: idHewan, jenis
              });
            }
          }
          result.push(hewanObj);
        }
        return result;
      }

            // ─── Render ────────────────────────────────────────────────────
      function updateDataOnPage(mudhohiList, jenis) {
        const exploreSection = document.getElementById('explore');
        exploreSection.innerHTML = '';
        document.querySelectorAll('.modal-dinamis').forEach(el => el.remove());
        const body = document.querySelector('body');
        const iconClass = jenis === 'sapi' ? 'fa-cow' : 'fa-hippo';
        const warna = jenis === 'sapi' ? '#74C0FC' : '#63d88a';

        if (mudhohiList.length === 0) {
          exploreSection.innerHTML = '<p class="text-muted">Tidak ada data yang perlu diproses.</p>';
          return;
        }

        for (let index = 0; index < Math.ceil(mudhohiList.length / 3); index++) {
          const container = document.createElement('div');
          container.className = 'project-container';
          for (let i = index * 3; i < Math.min(index * 3 + 3, mudhohiList.length); i++) {
            const m = mudhohiList[i];
            const { idMudhohi, noHewan } = m;

            // Card
            const box = document.createElement('div');
            box.className = 'project-box';
            box.setAttribute('data-bs-toggle', 'modal');
            box.setAttribute('data-bs-target', `#modalMudhohi${idMudhohi}`);
            box.innerHTML = `
              <i class="fa-solid ${iconClass}" style="color:${warna};"></i>
              <h3>${m.name || '-'}</h3>
              <label>${m.alamat || '-'}</label>
              <label>No ${jenis === 'sapi' ? 'Sapi' : 'Kambing'}: ${noHewan}</label>
              <span class="badge bg-${jenis === 'sapi' ? 'primary' : 'success'} mt-1">${jenis.toUpperCase()}</span>
            `;
            container.appendChild(box);

            // Modal konfirmasi
            const modal = document.createElement('div');
            modal.className = 'modal fade modal-dinamis';
            modal.id = `modalMudhohi${idMudhohi}`;
            modal.setAttribute('tabindex', '-1');
            modal.innerHTML = `
              <div class="modal-dialog"><div class="modal-content">
                <div class="modal-header">
                  <h1 class="modal-title fs-5">${m.name || '-'}</h1>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                  <b>Alamat:</b> ${m.alamat || '-'}<br>
                  <b>No HP:</b> ${m.noHP || '-'}<br>
                  <b>Hewan:</b> ${jenis.toUpperCase()} No ${noHewan}
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                  <button type="button" class="btn btn-danger postponeDagingButton"
                    data-idmudhohi="${idMudhohi}" data-idhewan="${noHewan}" data-jenis="${jenis}">Postpone</button>
                  <button type="button" class="btn btn-primary uploadGambarButton"
                    data-idmudhohi="${idMudhohi}" data-idhewan="${noHewan}" data-jenis="${jenis}">Deliver</button>
                </div>
              </div></div>
            `;
            body.appendChild(modal);

            // Modal upload
            const modalUpload = document.createElement('div');
            modalUpload.className = 'modal fade modal-dinamis';
            modalUpload.id = `modalMudhohiUpload${idMudhohi}`;
            modalUpload.setAttribute('tabindex', '-1');
            modalUpload.innerHTML = `
              <div class="modal-dialog"><div class="modal-content">
                <div class="modal-header">
                  <h1 class="modal-title fs-5">Upload Bukti — ${m.name || '-'}</h1>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                  <label class="form-label">Foto Bukti Pengiriman</label>
                  <input type="file" class="form-control" id="imageFile${idMudhohi}" accept="image/*" required>
                  <div id="uploadStatus${idMudhohi}" class="mt-2 small"></div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                  <button type="button" class="btn btn-primary deliverDagingButton"
                    data-idmudhohi="${idMudhohi}" data-idhewan="${noHewan}" data-jenis="${jenis}">Deliver</button>
                </div>
              </div></div>
            `;
            body.appendChild(modalUpload);
          }
          exploreSection.appendChild(container);
        }

        // Handler: buka modal upload
        document.querySelectorAll('.uploadGambarButton').forEach(btn => {
          btn.addEventListener('click', e => {
            e.preventDefault();
            const idMudhohi = btn.dataset.idmudhohi;
            closeModal(`modalMudhohi${idMudhohi}`);
            setTimeout(() => {
              new bootstrap.Modal(document.getElementById(`modalMudhohiUpload${idMudhohi}`), { keyboard: false }).show();
            }, 350);
          });
        });

        // Handler: deliver (upload ke Cloudinary via backend, lalu PUT /deliver)
        document.querySelectorAll('.deliverDagingButton').forEach(btn => {
          btn.addEventListener('click', async e => {
            e.preventDefault();
            const { idmudhohi: idMudhohi, idhewan, jenis: jenisDariModal } = btn.dataset;
            const idHewan = parseInt(idhewan);
            const fileInput = document.getElementById(`imageFile${idMudhohi}`);
            const file = fileInput.files[0];
            const statusEl = document.getElementById(`uploadStatus${idMudhohi}`);

            if (!file) {
              statusEl.textContent = 'Pilih file gambar terlebih dahulu.';
              statusEl.className = 'text-danger small';
              return;
            }

            try {
              btn.disabled = true;
              showLoading();
              statusEl.textContent = 'Mengupload gambar ke Cloudinary...';
              statusEl.className = 'text-muted small';

              // 1. Upload foto ke Cloudinary via backend
              const formData = new FormData();
              formData.append('bukti', file);
              const uploadRes = await fetch('/panitLt3/uploadBukti', { method: 'POST', body: formData });
              if (!uploadRes.ok) throw new Error((await uploadRes.json()).message || 'Upload gagal');
              const { url: downloadURL } = await uploadRes.json();

              fileInput.value = '';
              statusEl.textContent = 'Upload berhasil, menyimpan data...';

              // 2. Simpan data deliver ke Firebase
              const res = await fetch('/panitLt3/deliver', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ idSapi: idHewan, idMudhohi, bukti: downloadURL, jenis: jenisDariModal })
              });
              if (res.status !== 200) throw new Error((await res.json()).message);

              // Sukses: overlay tetap tampil sampai reload selesai
              location.reload();
            } catch (err) {
              // Error: sembunyikan overlay agar user bisa coba lagi
              hideLoading();
              btn.disabled = false;
              statusEl.textContent = 'Error: ' + err.message;
              statusEl.className = 'text-danger small';
            }
          });
        });

        // Handler: postpone
        document.querySelectorAll('.postponeDagingButton').forEach(btn => {
          btn.addEventListener('click', async e => {
            e.preventDefault();
            await withLoading(async () => {
              const { idmudhohi: idMudhohi, idhewan, jenis: jenisDariModal } = btn.dataset;
              const idHewan = parseInt(idhewan);
              const res = await fetch('/panitLt3/postpone', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ idSapi: idHewan, idMudhohi, jenis: jenisDariModal })
              });
              if (res.status === 200) { closeModal(`modalMudhohi${idMudhohi}`); location.reload(); }
            });
          });
        });
      }

      // ─── Helper tutup modal Bootstrap ──────────────────────────────
      function closeModal(modalId) {
        const el = document.getElementById(modalId);
        if (!el) return;
        const instance = bootstrap.Modal.getInstance(el);
        if (instance) {
          instance.hide();
          setTimeout(() => {
            el.classList.remove('show');
            el.removeAttribute('aria-modal');
            el.style.display = 'none';
            const backdrop = document.querySelector('.modal-backdrop');
            if (backdrop) backdrop.remove();
            document.body.classList.remove('modal-open');
            document.body.style = '';
            instance.dispose();
          }, 300);
        }
      }

      // ─── Listen realtime ───────────────────────────────────────────
      function listenHewan(jenis) {
        const ref = database.ref(jenis + '/');
        activeRef = ref;
        activeListener = ref.on('value', async snapshot => {
          if (currentTab !== jenis) return;
          const data = snapshot.val();
          if (!data) {
            document.getElementById('explore').innerHTML = `<p class="text-muted">Belum ada data ${jenis}.</p>`;
            return;
          }
          const arr = await transformHewanData(data, jenis);
          const filtered = arr.filter(h => h.state === 'Siap Dibagikan' || h.state === 'Sedang Dibagikan ke Mudhohi');
          let mudhohiList = filtered.flatMap(h => h.mudhohi);
          mudhohiList = mudhohiList.filter(m => !m.isDelivered && !m.isPostponed);
          updateDataOnPage(mudhohiList, jenis);
        });
      }

      // Mulai dengan sapi
      listenHewan('sapi');
    </script>
  </body>
</html>
