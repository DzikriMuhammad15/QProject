    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
      integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
      crossorigin="anonymous"
    ></script>
    <script src="/scripts/verifyMudhohiDashboardScript.js"></script>
    <script>
      // Konfigurasi Firebase

      // Inisialisasi Firebase
      var firebaseConfig = <%- JSON.stringify(firebaseConfig) %>;
      firebase.initializeApp(firebaseConfig);
      const database = firebase.database();

      // Referensi ke path data sapi
      const sapiRef = database.ref("sapi/");
      const candidateUsersRef = database.ref("userCandidate/");

      // Fungsi untuk memperbarui konten halaman
// Fungsi untuk memperbarui konten halaman
      function updateDataOnPage(candidateUser) {
        const exploreSection = document.getElementById("explore");
        exploreSection.innerHTML = "";
        const body = document.querySelector("body");

        for (let index = 0; index < Math.floor(candidateUser.length / 3) + 1; index++) {
          const projectContainer = document.createElement("div");
          projectContainer.className = "project-container";

          for (let i = index * 3; i < index * 3 + 3; i++) {
            if (i < candidateUser.length) {
              const cu = candidateUser[i];
              const projectBox = document.createElement("div");
              projectBox.className = "project-box";
              projectBox.setAttribute("data-bs-toggle", "modal");
              projectBox.setAttribute("data-bs-target", `#modalCandidateUser${cu.idUserCandidate}`);

              // Tampilkan ikon sesuai jenis hewan
              const iconClass = cu.noKambing ? 'fa-solid fa-hippo' : 'fa-solid fa-cow';
              const iconColor = cu.noKambing ? '#82C57A' : '#74C0FC';
              projectBox.innerHTML = `
                <i class="${iconClass}" style="color: ${iconColor};"></i>
                <h3>${cu.username}</h3>
                <label>${cu.name}</label>
              `;
              projectContainer.appendChild(projectBox);

              const modal = document.createElement("div");
              modal.className = "modal fade";
              modal.setAttribute("id", `modalCandidateUser${cu.idUserCandidate}`);
              modal.setAttribute("tabindex", "-1");
              modal.setAttribute("aria-labelledby", "exampleModalLabel");
              modal.setAttribute("aria-hidden", "true");

              // Info hewan
              let hewanInfo = '';
              if (cu.noSapi) hewanInfo += `<p>No Sapi: <b>${cu.noSapi}</b></p>`;
              if (cu.noKambing) hewanInfo += `<p>No Kambing: <b>${cu.noKambing}</b></p>`;
              if (!cu.noSapi && !cu.noKambing) hewanInfo = `<p class="text-muted">Tidak ada hewan terhubung</p>`;

              var temp = `<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">${cu.username}</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
            <div class="modal-body">
              <p>name : ${cu.name}</p>
              <p>role : ${cu.role}</p>
              ${hewanInfo}
              <p><b>Are you sure want to verify this user?</b></p>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              <button type="button" class="btn btn-primary verifyButton" data-id="${cu.idUserCandidate}" data-idmudhohi="${cu.idMudhohi}" >Yes</button>
            </div>
            `;
              temp += `</div>
        </div>
      </div>`;

              modal.innerHTML = temp;
              body.appendChild(modal);
            }
          }
          exploreSection.appendChild(projectContainer);
        }
      }

      async function transformData(data) {
        const result = [];
        for (const idUserCandidate in data) {
          const userCandidate = data[idUserCandidate];
          // Ambil detail mudhohiCandidate untuk mendapatkan noSapi/noKambing
          let noSapi = null, noKambing = null;
          if (userCandidate.mudhohiId) {
            const mudhohiCandidateSnap = await database.ref('mudhohiCandidate/' + userCandidate.mudhohiId).once('value');
            const mc = mudhohiCandidateSnap.val();
            if (mc) {
              noSapi = mc.noSapi || null;
              noKambing = mc.noKambing || null;
            }
          }
          result.push({
            idUserCandidate,
            name: userCandidate.name,
            username: userCandidate.username,
            role: userCandidate.role,
            idMudhohi: userCandidate.mudhohiId,
            noSapi,
            noKambing
          });
        }
        return result;
      }
      
      async function transformData(data) {
        const result = [];

        // Loop melalui setiap key di object data
        for (const idUserCandidate in data) {
          const userCandidate = data[idUserCandidate];
          const candidateObj = {
            idUserCandidate: idUserCandidate,
            name: userCandidate.name,
            username: userCandidate.username,
            role: userCandidate.role,
            idMudhohi: userCandidate.mudhohiId
          }
          result.push(candidateObj);
        }

        return result;
      }

      // Listen untuk perubahan data
      candidateUsersRef.on("value", async (snapshot) => {
        const data = snapshot.val();
        if (data) {
          console.log(data);
          const userCandidates = await transformData(data);
          console.log(userCandidates);
          const filteredData = userCandidates.filter((el) => {
            return el.role == "mudhohi"
          })
          console.log(filteredData);
          updateDataOnPage(filteredData);



          // verifyButton handler
          const projectBoxes = document.querySelectorAll(".project-box");
          console.log(projectBoxes);
          projectBoxes.forEach((projectBox) => {
            projectBox.addEventListener("click", async (e) => {
              e.preventDefault();
              const verifyButton = document.querySelectorAll(
                ".verifyButton"
              );
              console.log(verifyButton);
              verifyButton.forEach((verifyButton) => {
                verifyButton.addEventListener("click", async (e) => {
                  e.preventDefault();
                  const idUserCandidate = verifyButton.dataset.id;
                  const idMudhohiCandidate = verifyButton.dataset.idmudhohi;
                  console.log({idUserCandidate, idMudhohiCandidate});
                  // panggil endpoint untuk membuat panitLt1
                  const url = "/admin/postMudhohi";
                  const data = { idUserCandidate, idMudhohiCandidate };
                  const option = {
                    method: "POST",
                    headers: {
                      "Content-Type": "application/json",
                    },
                    body: JSON.stringify(data),
                  };
                  await withLoading(async () => {
                    const result = await fetch(url, option);
                    const statusCode = result.status;
                    const hasil = await result.json();
                    if (statusCode != 200) {
                      console.log(hasil);
                    } else {
                      location.reload();
                    }
                  });
                });
              });
            });
          });







        }
      });
    </script>
  </body>
</html>
