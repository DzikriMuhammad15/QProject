<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Stylesheets -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link
      href="https://unpkg.com/boxicons@2.0.9/css/boxicons.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/mainStyle.css" />
    <style>
      button {
        white-space: nowrap;
      }
    </style>
    <!-- --------- FAVICON ---------- -->
    <link
      rel="shortcut icon"
      href="assets/img/logiPsikologi.png"
      type="image/x-icon"
    />
    <!-- ANIME JS -->
    <script src="https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.min.js"></script>
    <title>Qurban</title>
    <!-- font awesome icon -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
      integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- Firebase SDK v8 -->
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>
  </head>
  <body>
    <!-- NAVBAR -->
    <nav>
      <i class="fa-solid fa-star-and-crescent icon" style="color: #74c0fc"></i>
      <a href="#" class="brand"> Qurban</a>
      <form action="#"></form>
      <span class="divider"></span>
      <button type="button" class="btn btn-primary" id="loginPageButton">
        Sign In / Sign Up
      </button>
    </nav>

    <!-- MAIN -->
    <main>
      <ul class="box-info">
        <li>
          <i class="bx bxs-calendar-check"></i>
          <span class="text">
            <h3 id="belumDiselbelihLive">-</h3>
            <p>Belum Disembelih</p>
          </span>
        </li>
        <li>
          <i class="bx bxs-group"></i>
          <span class="text">
            <h3 id="prosesPenyembelihanLive">-</h3>
            <p>Proses Penyembelihan</p>
          </span>
        </li>
        <li>
          <i class="bx bxs-dollar-circle"></i>
          <span class="text">
            <h3 id="pemrosesanDagingLive">-</h3>
            <p>Pemrosesan Daging</p>
          </span>
        </li>
      </ul>
      <ul class="box-info">
        <li>
          <i class="bx bxs-group"></i>
          <span class="text">
            <h3 id="siapDibagikanLive">-</h3>
            <p>Siap Dibagikan</p>
          </span>
        </li>
        <li>
          <i class="bx bxs-calendar-check"></i>
          <span class="text">
            <h3 id="sedangDibagikanKeMudhohiLive">-</h3>
            <p>Sedang Dibagikan ke Mudhohi</p>
          </span>
        </li>
        <li>
          <i class="bx bxs-group"></i>
          <span class="text">
            <h3 id="selesaiDibagikanLive">-</h3>
            <p>Selesai Dibagikan</p>
          </span>
        </li>
      </ul>
      <div class="info-data">
        <section class="section" id="explore">
          <!-- Project boxes will be dynamically inserted here -->
        </section>
      </div>
      <div class="data"></div>
    </main>

    <!-- Modal Logout -->
    <div class="modal fade" id="modalLogout" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">Logout</h1>
          </div>
          <div class="modal-body">Are you sure want to logout?</div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Back
            </button>
            <a href="/auth/logout">
              <button type="button" class="btn btn-danger lastLogoutButton">
                Logout
              </button>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- JavaScript SDK -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
      integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
      integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
      crossorigin="anonymous"
    ></script>
    <script src="scripts/adminScript.js"></script>
<script type="module">
      import anime from "https://cdn.jsdelivr.net/npm/animejs@3.2.1/+esm";
      var firebaseConfig = <%- JSON.stringify(firebaseConfig) %>;
      firebase.initializeApp(firebaseConfig);
      const database = firebase.database();

      function animateCountUpdate(element, newValue) {
        const currentValue = element.innerText;
        const container = document.createElement("div");
        container.style.position = "relative";
        container.style.display = "inline-block";
        container.style.height = element.offsetHeight + "px";
        container.style.width = element.offsetWidth + "px";
        const oldValueElement = document.createElement("div");
        oldValueElement.innerText = currentValue;
        oldValueElement.style.cssText = `position:absolute;top:0;left:0;width:100%;height:100%;font-size:${window.getComputedStyle(element).fontSize};font-weight:${window.getComputedStyle(element).fontWeight};line-height:${window.getComputedStyle(element).lineHeight};text-align:${window.getComputedStyle(element).textAlign};`;
        container.appendChild(oldValueElement);
        const newValueElement = document.createElement("div");
        newValueElement.innerText = newValue;
        newValueElement.style.cssText = oldValueElement.style.cssText + "opacity:0;";
        container.appendChild(newValueElement);
        element.innerHTML = "";
        element.appendChild(container);
        anime({ targets: oldValueElement, translateY: -50, duration: 500, easing: "easeInOutQuad", complete: () => oldValueElement.remove() });
        anime({ targets: newValueElement, opacity: [0, 1], translateY: [50, 0], duration: 500, easing: "easeInOutQuad",
          complete: () => { newValueElement.style.position = "static"; container.style.height = "auto"; container.style.width = "auto"; }
        });
      }

      // ── Render semua hewan (sapi + kambing) ke explore section ──
      function updateDataOnPage(hewanArray) {
        const exploreSection = document.getElementById("explore");
        exploreSection.innerHTML = "";
        const body = document.querySelector("body");
        document.querySelectorAll('[id^="modalHewan-"]').forEach(el => el.remove());

        for (let index = 0; index < Math.ceil(hewanArray.length / 3); index++) {
          const projectContainer = document.createElement("div");
          projectContainer.className = "project-container";
          for (let i = index * 3; i < Math.min(index * 3 + 3, hewanArray.length); i++) {
            const hewan = hewanArray[i];
            const modalId = `modalHewan-${hewan.jenis}-${hewan.idHewan}`;
            const projectBox = document.createElement("div");
            projectBox.className = "project-box";
            projectBox.setAttribute("data-bs-toggle", "modal");
            projectBox.setAttribute("data-bs-target", `#${modalId}`);
            const iconClass = hewan.jenis === 'kambing' ? 'fa-solid fa-hippo' : 'fa-solid fa-cow';
            const iconColor = hewan.jenis === 'kambing' ? '#82C57A' : '#74C0FC';
            projectBox.innerHTML = `
              <i class="${iconClass}" style="color:${iconColor};"></i>
              <h3>${hewan.jenis === 'kambing' ? 'Kambing' : 'Sapi'} ${hewan.idHewan}</h3>
              <label>${hewan.state}</label>
            `;
            projectContainer.appendChild(projectBox);

            const modal = document.createElement("div");
            modal.className = "modal fade";
            modal.setAttribute("id", modalId);
            modal.setAttribute("tabindex", "-1");
            let mudhohiHtml = '';
            hewan.mudhohi.forEach(m => {
              mudhohiHtml += `<hr><h2 class="fs-5">${m.name || '-'}</h2><p>${m.alamat || '-'}</p>`;
            });
            modal.innerHTML = `
              <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                  <div class="modal-header">
                    <h1 class="modal-title fs-5">${hewan.jenis === 'kambing' ? 'Kambing' : 'Sapi'} ${hewan.idHewan}</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                  </div>
                  <div class="modal-body">${mudhohiHtml}</div>
                </div>
              </div>`;
            body.appendChild(modal);
          }
          exploreSection.appendChild(projectContainer);
        }
      }

      async function transformHewan(sapiData, kambingData) {
        const result = [];
        if (sapiData) {
          for (const id in sapiData) {
            const h = sapiData[id];
            const obj = { idHewan: id, jenis: 'sapi', state: h.state, mudhohi: [] };
            for (const key in h) {
              if (key !== 'foto' && key !== 'state' && typeof h[key] === 'object') {
                const mudhohiObj = await database.ref("mudhohis/" + key).once("value").then(s => s.val());
                const userObj = await database.ref("users/").orderByChild("mudhohiId").equalTo(key).once("value").then(s => {
                  const d = s.val(); if (d) { const k = Object.keys(d)[0]; return d[k].name; } return null;
                });
                obj.mudhohi.push({ idMudhohi: key, ...mudhohiObj, name: userObj });
              }
            }
            result.push(obj);
          }
        }
        if (kambingData) {
          for (const id in kambingData) {
            const h = kambingData[id];
            const obj = { idHewan: id, jenis: 'kambing', state: h.state, mudhohi: [] };
            for (const key in h) {
              if (key !== 'foto' && key !== 'state' && typeof h[key] === 'object') {
                const mudhohiObj = await database.ref("mudhohis/" + key).once("value").then(s => s.val());
                const userObj = await database.ref("users/").orderByChild("mudhohiId").equalTo(key).once("value").then(s => {
                  const d = s.val(); if (d) { const k = Object.keys(d)[0]; return d[k].name; } return null;
                });
                obj.mudhohi.push({ idMudhohi: key, ...mudhohiObj, name: userObj });
              }
            }
            result.push(obj);
          }
        }
        return result;
      }

      function areArraysEqual(a, b) {
        if (a.length !== b.length) return false;
        const sa = a.slice().sort(), sb = b.slice().sort();
        return sa.every((v, i) => v === sb[i]);
      }

      // ── State tracker: sapi ──
      let idBelumDisembelihGlobal = [], idProsesPenyembelihanGlobal = [], idPemrosesanDagingGlobal = [];
      let idSiapDibagikanGlobal = [], idSedangDibagikanKeMudhohiGlobal = [], idSelesaiDibagikanGlobal = [];
      // ── State tracker: kambing ──
      let idKambingBelumDisembelihGlobal = [], idKambingProsesPenyembelihanGlobal = [], idKambingPemrosesanDagingGlobal = [];
      let idKambingSiapDibagikanGlobal = [], idKambingSedangDibagikanKeMudhohiGlobal = [], idKambingSelesaiDibagikanGlobal = [];

      let latestSapiData = null;
      let latestKambingData = null;

      function updateCounters(sapiArray, kambingArray) {
        // ── Sapi ──
        const grpSapi = { 'Belum Disembelih': [], 'Proses Penyembelihan': [], 'Pemrosesan Daging': [], 'Siap Dibagikan': [], 'Sedang Dibagikan ke Mudhohi': [], 'Selesai Dibagikan ke Mudhohi': [] };
        sapiArray.forEach(el => {
          if (el.state === 'Belum Disembelih') grpSapi['Belum Disembelih'].push(el.idHewan);
          else if (el.state === 'Proses Penyembelihan') grpSapi['Proses Penyembelihan'].push(el.idHewan);
          else if (el.state === 'Pemrosesan Daging') grpSapi['Pemrosesan Daging'].push(el.idHewan);
          else if (el.state === 'Siap Dibagikan') grpSapi['Siap Dibagikan'].push(el.idHewan);
          else if (el.state === 'Sedang Dibagikan ke Mudhohi') grpSapi['Sedang Dibagikan ke Mudhohi'].push(el.idHewan);
          else if (el.state === 'Selesai Dibagikan ke Mudhohi') grpSapi['Selesai Dibagikan ke Mudhohi'].push(el.idHewan);
        });
        // ── Kambing ──
        const grpKambing = { 'Belum Disembelih': [], 'Proses Penyembelihan': [], 'Pemrosesan Daging': [], 'Siap Dibagikan': [], 'Sedang Dibagikan ke Mudhohi': [], 'Selesai Dibagikan ke Mudhohi': [] };
        kambingArray.forEach(el => {
          if (el.state === 'Belum Disembelih') grpKambing['Belum Disembelih'].push(el.idHewan);
          else if (el.state === 'Proses Penyembelihan') grpKambing['Proses Penyembelihan'].push(el.idHewan);
          else if (el.state === 'Pemrosesan Daging') grpKambing['Pemrosesan Daging'].push(el.idHewan);
          else if (el.state === 'Siap Dibagikan') grpKambing['Siap Dibagikan'].push(el.idHewan);
          else if (el.state === 'Sedang Dibagikan ke Mudhohi') grpKambing['Sedang Dibagikan ke Mudhohi'].push(el.idHewan);
          else if (el.state === 'Selesai Dibagikan ke Mudhohi') grpKambing['Selesai Dibagikan ke Mudhohi'].push(el.idHewan);
        });

        // Helper: gabungkan label S=sapi K=kambing
        function mergeLabel(arrS, arrK) {
          const parts = [];
          if (arrS.length) parts.push('Sapi: ' + arrS.join(', '));
          if (arrK.length) parts.push('Kambing: ' + arrK.join(', '));
          return parts.length ? parts.join(' | ') : '-';
        }

        const pairs = [
          { el: 'belumDiselbelihLive',            sArr: grpSapi['Belum Disembelih'],          kArr: grpKambing['Belum Disembelih'],          sGlob: idBelumDisembelihGlobal,          kGlob: idKambingBelumDisembelihGlobal },
          { el: 'prosesPenyembelihanLive',         sArr: grpSapi['Proses Penyembelihan'],       kArr: grpKambing['Proses Penyembelihan'],       sGlob: idProsesPenyembelihanGlobal,      kGlob: idKambingProsesPenyembelihanGlobal },
          { el: 'pemrosesanDagingLive',            sArr: grpSapi['Pemrosesan Daging'],          kArr: grpKambing['Pemrosesan Daging'],          sGlob: idPemrosesanDagingGlobal,         kGlob: idKambingPemrosesanDagingGlobal },
          { el: 'siapDibagikanLive',               sArr: grpSapi['Siap Dibagikan'],             kArr: grpKambing['Siap Dibagikan'],             sGlob: idSiapDibagikanGlobal,            kGlob: idKambingSiapDibagikanGlobal },
          { el: 'sedangDibagikanKeMudhohiLive',    sArr: grpSapi['Sedang Dibagikan ke Mudhohi'],    kArr: grpKambing['Sedang Dibagikan ke Mudhohi'],    sGlob: idSedangDibagikanKeMudhohiGlobal, kGlob: idKambingSedangDibagikanKeMudhohiGlobal },
          { el: 'selesaiDibagikanLive',            sArr: grpSapi['Selesai Dibagikan ke Mudhohi'],   kArr: grpKambing['Selesai Dibagikan ke Mudhohi'],   sGlob: idSelesaiDibagikanGlobal,         kGlob: idKambingSelesaiDibagikanGlobal },
        ];

        pairs.forEach(p => {
          const changed = !areArraysEqual(p.sArr, p.sGlob) || !areArraysEqual(p.kArr, p.kGlob);
          if (changed) {
            animateCountUpdate(document.getElementById(p.el), mergeLabel(p.sArr, p.kArr));
            p.sGlob.splice(0, p.sGlob.length, ...p.sArr);
            p.kGlob.splice(0, p.kGlob.length, ...p.kArr);
          }
        });
      }

      async function refreshView() {
        const sapiArr = latestSapiData ? (await transformHewan(latestSapiData, null)).filter(h => h.jenis === 'sapi') : [];
        const kambingArr = latestKambingData ? (await transformHewan(null, latestKambingData)).filter(h => h.jenis === 'kambing') : [];
        updateCounters(sapiArr, kambingArr);
        const hewanArray = await transformHewan(latestSapiData, latestKambingData);
        updateDataOnPage(hewanArray);
      }

      database.ref("sapi/").on("value", async snapshot => {
        latestSapiData = snapshot.val();
        refreshView();
      });
      database.ref("kambing/").on("value", async snapshot => {
        latestKambingData = snapshot.val();
        refreshView();
      });

      const loginPageButton = document.getElementById("loginPageButton");
      loginPageButton.addEventListener("click", async e => {
        e.preventDefault();
        location.assign("/auth");
      });
    </script>
  </body>
</html>
