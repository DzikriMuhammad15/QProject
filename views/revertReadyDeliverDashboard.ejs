<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="https://unpkg.com/boxicons@2.0.9/css/boxicons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/stylesheets/revertReadyDeliverDashboardStyle.css" />
    <title>Qurban</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>
    <link rel="stylesheet" href="/stylesheets/loading.css" />
  </head>
  <body>
  <div id="loadingOverlay"><div class="loading-spinner"></div><p class="loading-text">Memproses...</p></div>
  <script src="/scripts/loading.js"></script>
    <section id="sidebar">
      <a href="#" class="brand"><i class="fa-solid fa-star-and-crescent icon" style="color: #74c0fc"></i> Qurban</a>
      <ul class="side-menu">
        <li><a href="/panitLt2"><i class="bx bxs-dashboard icon"></i> Dashboard</a></li>
        <li class="divider" data-text="main">Main</li>
        <li><a href="/panitLt2/setPemrosesanDagingDashboard"><i class="bx bxs-chart icon"></i> Set Pemrosesan Daging</a></li>
        <li><a href="/panitLt2/revertPemrosesanDagingDashboard"><i class="bx bxs-chart icon"></i> Revert Pemrosesan Daging</a></li>
        <li><a href="/panitLt2/setReadyDeliverDashboard"><i class="bx bxs-chart icon"></i> Set Ready Deliver</a></li>
        <li><a href="#" class="active"><i class="bx bxs-chart icon"></i> Revert Ready Deliver</a></li>
      </ul>
    </section>

    <section id="content">
      <nav>
        <i class="bx bx-menu toggle-sidebar"></i>
        <form action="#"></form>
        <span class="divider"></span>
        <div class="profile">
          <img src="/img/people.png" alt="" />
          <ul class="profile-link">
            <li><a data-bs-toggle="modal" data-bs-target="#modalLogout"><i class="bx bxs-log-out-circle"></i> Logout</a></li>
          </ul>
        </div>
      </nav>
      <main>
        <ul class="breadcrumbs">
          <li><a href="#">Home</a></li>
          <li class="divider">/</li>
          <li><a href="#" class="active">Dashboard</a></li>
          <li class="divider">/</li>
          <li><a href="#" class="active">Revert Ready Deliver</a></li>
        </ul>
        <div class="d-flex gap-2 mb-3">
          <button class="btn btn-primary" id="tabSapi" onclick="switchTab('sapi')">
            <i class="fa-solid fa-cow me-1"></i> Sapi
          </button>
          <button class="btn btn-outline-success" id="tabKambing" onclick="switchTab('kambing')">
            <i class="fa-solid fa-hippo me-1"></i> Kambing
          </button>
        </div>
        <div class="info-data">
          <section class="section" id="explore"></section>
        </div>
        <div class="data"></div>
      </main>
    </section>

    <div class="modal fade" id="modalLogout" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header"><h1 class="modal-title fs-5">Logout</h1></div>
          <div class="modal-body">Are you sure want to logout?</div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Back</button>
            <a href="/auth/logout"><button type="button" class="btn btn-danger">Logout</button></a>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
    <script src="/scripts/revertReadyDeliverDashboardScript.js"></script>
    <script>
      var firebaseConfig = <%- JSON.stringify(firebaseConfig) %>;
      firebase.initializeApp(firebaseConfig);
      const database = firebase.database();

      let currentTab = 'sapi';
      let activeRef = null;
      let activeListener = null;

      function switchTab(jenis) {
        currentTab = jenis;
        document.getElementById('tabSapi').className = jenis === 'sapi' ? 'btn btn-primary' : 'btn btn-outline-primary';
        document.getElementById('tabKambing').className = jenis === 'kambing' ? 'btn btn-success' : 'btn btn-outline-success';
        document.getElementById('explore').innerHTML = '';
        document.querySelectorAll('.modal-dinamis').forEach(el => el.remove());
        if (activeRef && activeListener) { activeRef.off('value', activeListener); }
        listenHewan(jenis);
      }

      function closeModal(modalId) {
        const el = document.getElementById(modalId);
        if (!el) return;
        const instance = bootstrap.Modal.getInstance(el);
        if (instance) {
          instance.hide();
          setTimeout(() => {
            el.classList.remove('show'); el.removeAttribute('aria-modal'); el.style.display = 'none';
            const backdrop = document.querySelector('.modal-backdrop');
            if (backdrop) backdrop.remove();
            document.body.classList.remove('modal-open'); document.body.style = '';
            instance.dispose();
          }, 300);
        }
      }

      function updateDataOnPage(hewanArr, jenis) {
        const exploreSection = document.getElementById('explore');
        exploreSection.innerHTML = '';
        document.querySelectorAll('.modal-dinamis').forEach(el => el.remove());
        const body = document.querySelector('body');
        const iconClass = jenis === 'sapi' ? 'fa-cow' : 'fa-hippo';
        const warna = jenis === 'sapi' ? '#74C0FC' : '#51CF66';
        const labelHewan = jenis === 'sapi' ? 'Sapi' : 'Kambing';

        for (let index = 0; index < Math.ceil(hewanArr.length / 3); index++) {
          const projectContainer = document.createElement('div');
          projectContainer.className = 'project-container';
          for (let i = index * 3; i < Math.min(index * 3 + 3, hewanArr.length); i++) {
            const h = hewanArr[i];
            const idHewan = h.idSapi;
            const modalId = `modalHewan${jenis}${idHewan}`;

            const projectBox = document.createElement('div');
            projectBox.className = 'project-box';
            projectBox.setAttribute('data-bs-toggle', 'modal');
            projectBox.setAttribute('data-bs-target', `#${modalId}`);
            projectBox.innerHTML = `
              <i class="fa-solid ${iconClass}" style="color:${warna};"></i>
              <h3>${labelHewan} ${idHewan}</h3>
              <label>${h.state}</label>
            `;
            projectContainer.appendChild(projectBox);

            const modal = document.createElement('div');
            modal.className = 'modal fade modal-dinamis';
            modal.setAttribute('id', modalId);
            modal.setAttribute('tabindex', '-1');
            modal.innerHTML = `
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header">
                    <h1 class="modal-title fs-5">${labelHewan} ${idHewan}</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                  </div>
                  <div class="modal-body">
                    Are you sure want to Revert State of <b>${labelHewan} ${idHewan}</b> to <b>"Pemrosesan Daging"</b>?
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary sembelihHewanButton" data-id="${idHewan}" data-jenis="${jenis}">Yes</button>
                  </div>
                </div>
              </div>`;
            body.appendChild(modal);
          }
          exploreSection.appendChild(projectContainer);
        }

        document.querySelectorAll('.sembelihHewanButton').forEach(btn => {
          btn.addEventListener('click', async e => {
            e.preventDefault();
            await withLoading(async () => {
              const idHewan = btn.dataset.id;
              const jenisDari = btn.dataset.jenis;
              const result = await fetch('/panitLt2/revertReadyDeliver', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ idSapi: idHewan, jenis: jenisDari })
              });
              if (result.status === 200) { closeModal(`modalHewan${jenisDari}${idHewan}`); location.reload(); }
              else { console.log(await result.json()); }
            });
          });
        });
      }

      async function transformHewanData(data, jenis) {
        const result = [];
        for (const idHewan in data) {
          const hewan = data[idHewan];
          const hewanObj = { idSapi: idHewan, foto: hewan.foto, state: hewan.state, mudhohi: [] };
          for (const key in hewan) {
            if (key !== 'foto' && key !== 'state' && typeof hewan[key] === 'object') {
              const mudhohiObj = await database.ref('mudhohis/' + key).once('value').then(s => s.val());
              const userObj = await database.ref('users/').orderByChild('mudhohiId').equalTo(key).once('value').then(s => {
                const d = s.val(); if (d) { const k = Object.keys(d)[0]; return d[k].name; } return null;
              });
              hewanObj.mudhohi.push({ idMudhohi: key, ...mudhohiObj, name: userObj });
            }
          }
          result.push(hewanObj);
        }
        return result;
      }

      function listenHewan(jenis) {
        const ref = database.ref(jenis + '/');
        activeRef = ref;
        activeListener = ref.on('value', async snapshot => {
          if (currentTab !== jenis) return;
          const data = snapshot.val();
          if (data) {
            const arr = await transformHewanData(data, jenis);
            updateDataOnPage(arr.filter(h => h.state === 'Siap Dibagikan'), jenis);
          } else {
            document.getElementById('explore').innerHTML = `<p class="text-muted">Belum ada data ${jenis}.</p>`;
          }
        });
      }

      listenHewan('sapi');
    </script>
  </body>
</html>