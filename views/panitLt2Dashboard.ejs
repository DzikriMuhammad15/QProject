<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Stylesheets -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <link
      href="https://unpkg.com/boxicons@2.0.9/css/boxicons.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/stylesheets/panitLt2Style.css" />
    <!-- --------- FAVICON ---------- -->
    <link
      rel="shortcut icon"
      href="assets/img/logiPsikologi.png"
      type="image/x-icon"
    />
    <title>Qurban</title>
    <!-- font awesome icon -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
      integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- Firebase SDK v8 -->
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>
    <!-- SheetJS untuk generate Excel di client -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <link rel="stylesheet" href="/stylesheets/loading.css" />
  </head>
  <body>
  <div id="loadingOverlay"><div class="loading-spinner"></div><p class="loading-text">Memproses...</p></div>
  <script src="/scripts/loading.js"></script>
    <!-- SIDEBAR -->
    <section id="sidebar">
      <a href="#" class="brand"
        ><i
          class="fa-solid fa-star-and-crescent icon"
          style="color: #74c0fc"
        ></i>
        Qurban</a
      >
      <ul class="side-menu">
        <li>
          <a href="#" class="active"
            ><i class="bx bxs-dashboard icon"></i> Dashboard</a
          >
        </li>
        <li class="divider" data-text="main">Main</li>
        <li>
          <a href="/panitLt2/setPemrosesanDagingDashboard"
            ><i class="bx bxs-chart icon"></i> Set Pemrosesan Daging</a
          >
        </li>
        <li>
          <a href="/panitLt2/revertPemrosesanDagingDashboard"
            ><i class="bx bxs-chart icon"></i> Revert Pemrosesan Daging</a
          >
        </li>
        <li>
          <a href="/panitLt2/setReadyDeliverDashboard"
            ><i class="bx bxs-chart icon"></i> Set Ready Deliver</a
          >
        </li>
        <li>
          <a href="/panitLt2/revertReadyDeliverDashboard"
            ><i class="bx bxs-chart icon"></i> Revert Ready Deliver</a
          >
        </li>
      </ul>
    </section>

    <!-- NAVBAR -->
    <section id="content">
      <nav>
        <i class="bx bx-menu toggle-sidebar"></i>
        <form action="#"></form>
        <span class="divider"></span>
        <div class="profile">
          <img src="/img/people.png" alt="" />
          <ul class="profile-link">
            <li>
              <a data-bs-toggle="modal" data-bs-target="#modalLogout"
                ><i class="bx bxs-log-out-circle"></i> Logout</a
              >
            </li>
          </ul>
        </div>
      </nav>

      <!-- MAIN -->
      <main>
        <h1 class="title">Hello, <%= currentUser.name %></h1>
        <ul class="breadcrumbs">
          <li><a href="#">Home</a></li>
          <li class="divider">/</li>
          <li><a href="#" class="active">Dashboard</a></li>
        </ul>
          <div class="info-data">
            <div class="d-flex gap-2 mb-3 flex-wrap">
              <button class="btn btn-primary" id="tabSapi" onclick="switchTab('sapi')">
                <i class="fa-solid fa-cow me-1"></i> Sapi
              </button>
              <button class="btn btn-outline-success" id="tabKambing" onclick="switchTab('kambing')">
                <i class="fa-solid fa-hippo me-1"></i> Kambing
              </button>
              <button type="button" class="btn btn-warning" onclick="downloadExcel()">
                <i class="fa-solid fa-file-excel me-1"></i> Download Snapshot Excel
              </button>
            </div>
            <section class="section" id="explore">
              <!-- Project boxes will be dynamically inserted here -->
            </section>
          </div>
        <div class="data"></div>
      </main>
    </section>

    <!-- Modal Logout -->
    <div class="modal fade" id="modalLogout" tabindex="-1">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">Logout</h1>
          </div>
          <div class="modal-body">Are you sure want to logout?</div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Back
            </button>
            <a href="/auth/logout">
              <button type="button" class="btn btn-danger lastLogoutButton">
                Logout
              </button>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- JavaScript SDK -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
      integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"
      integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy"
      crossorigin="anonymous"
    ></script>
    <script src="scripts/panitLt2Script.js"></script>
<script>
      var firebaseConfig = <%- JSON.stringify(firebaseConfig) %>;
      firebase.initializeApp(firebaseConfig);
      const database = firebase.database();

      let currentTab = 'sapi';
      let activeRef = null;
      let activeListener = null;

      function switchTab(jenis) {
        currentTab = jenis;
        document.getElementById('tabSapi').className = jenis === 'sapi' ? 'btn btn-primary' : 'btn btn-outline-primary';
        document.getElementById('tabKambing').className = jenis === 'kambing' ? 'btn btn-success' : 'btn btn-outline-success';
        document.getElementById('explore').innerHTML = '';
        document.querySelectorAll('.modal-dinamis').forEach(el => el.remove());
        if (activeRef && activeListener) {
          activeRef.off('value', activeListener);
        }
        listenHewan(jenis);
      }

      function updateDataOnPage(hewanArr, jenis) {
        const exploreSection = document.getElementById('explore');
        exploreSection.innerHTML = '';
        document.querySelectorAll('.modal-dinamis').forEach(el => el.remove());
        const body = document.querySelector('body');
        const iconClass = jenis === 'sapi' ? 'fa-cow' : 'fa-hippo';
        const warna = jenis === 'sapi' ? '#74C0FC' : '#51CF66';
        const labelHewan = jenis === 'sapi' ? 'Sapi' : 'Kambing';

        for (let index = 0; index < Math.ceil(hewanArr.length / 3); index++) {
          const projectContainer = document.createElement('div');
          projectContainer.className = 'project-container';
          for (let i = index * 3; i < Math.min(index * 3 + 3, hewanArr.length); i++) {
            const h = hewanArr[i];
            const idHewan = h.idSapi;
            const projectBox = document.createElement('div');
            projectBox.className = 'project-box';
            projectBox.setAttribute('data-bs-toggle', 'modal');
            projectBox.setAttribute('data-bs-target', `#modalHewan${jenis}${idHewan}`);
            projectBox.innerHTML = `
              <i class="fa-solid ${iconClass}" style="color:${warna};"></i>
              <h3>${labelHewan} ${idHewan}</h3>
              <label>${h.state}</label>
            `;
            projectContainer.appendChild(projectBox);

            let modal = document.getElementById(`modalHewan${jenis}${idHewan}`);
            const mudhohiHtml = h.mudhohi.map(m => {
              let statusHtml = '';
              if (m.isPostponed && !m.isDelivered) {
                statusHtml = `<p>Status: <b>Tertunda</b></p>`;
              } else if (m.isDelivered && !m.isPostponed) {
                statusHtml = `<p>Status: <b>Sudah dikirim</b></p>
                  <p>Username pengirim: ${m.usernamePengirim}</p>
                  <p>Bukti:</p>
                  <img src="${m.bukti}" style="width:300px;height:auto;border-radius:15px;object-fit:cover;" />`;
              } else {
                statusHtml = `<p>Status: <b>Belum dikirim</b></p>`;
              }
              return `<hr><h2 class="fs-5">${m.name || '-'}</h2><p>Alamat: ${m.alamat || '-'}</p>${statusHtml}`;
            }).join('');

            const modalContent = `
              <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                  <div class="modal-header">
                    <h1 class="modal-title fs-5">${labelHewan} ${idHewan}</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                  </div>
                  <div class="modal-body">${mudhohiHtml}</div>
                </div>
              </div>`;

            if (modal) {
              modal.innerHTML = modalContent;
            } else {
              modal = document.createElement('div');
              modal.className = 'modal fade modal-dinamis';
              modal.setAttribute('id', `modalHewan${jenis}${idHewan}`);
              modal.setAttribute('tabindex', '-1');
              modal.innerHTML = modalContent;
              body.appendChild(modal);
            }
          }
          exploreSection.appendChild(projectContainer);
        }
      }

      async function transformHewanData(data, jenis) {
        const result = [];
        for (const idHewan in data) {
          const hewan = data[idHewan];
          const hewanObj = { idSapi: idHewan, foto: hewan.foto, state: hewan.state, mudhohi: [] };
          for (const key in hewan) {
            if (key !== 'foto' && key !== 'state' && typeof hewan[key] === 'object') {
              const mudhohiObj = await database.ref('mudhohis/' + key).once('value').then(s => s.val());
              const userObj = await database.ref('users/').orderByChild('mudhohiId').equalTo(key).once('value').then(s => {
                const d = s.val();
                if (d) { const k = Object.keys(d)[0]; return d[k].name; }
                return null;
              });
              hewanObj.mudhohi.push({
                idMudhohi: key, ...mudhohiObj, name: userObj,
                isDelivered: hewan[key].isDelivered,
                isPostponed: hewan[key].isPostponed,
                bukti: hewan[key].bukti,
                usernamePengirim: hewan[key].usernamePengirim
              });
            }
          }
          result.push(hewanObj);
        }
        return result;
      }

      function listenHewan(jenis) {
        const ref = database.ref(jenis + '/');
        activeRef = ref;
        activeListener = ref.on('value', async snapshot => {
          if (currentTab !== jenis) return;
          const data = snapshot.val();
          if (data) {
            const arr = await transformHewanData(data, jenis);
            updateDataOnPage(arr, jenis);
          } else {
            document.getElementById('explore').innerHTML = `<p class="text-muted">Belum ada data ${jenis}.</p>`;
          }
        });
      }

      listenHewan('sapi');

      // =============================================================
      // DOWNLOAD SNAPSHOT EXCEL (panitLt2)
      // =============================================================
      async function downloadExcel() {
        const btn = document.querySelector('[onclick="downloadExcel()"]');
        if (btn) { btn.disabled = true; btn.textContent = "Memproses..."; }
        try {
          const response = await fetch("/panitLt2/snapshot");
          if (!response.ok) throw new Error("Gagal mengambil data snapshot");
          const json = await response.json();
          const rows = json.data;

          const headers = [
            "Jenis Hewan", "No Hewan", "State", "Foto Hewan (URL)",
            "ID Mudhohi", "Nama Mudhohi", "Alamat", "No HP",
            "Sudah Dikirim?", "Tertunda?", "Bukti (URL)", "Username Pengirim"
          ];

          const wsData = [headers];
          rows.forEach(row => {
            wsData.push([
              row.jenis, row.noHewan, row.state, row.fotoHewan,
              row.idMudhohi, row.namaMudhohi, row.alamat, row.noHP,
              row.isDelivered, row.isPostponed, row.bukti, row.usernamePengirim
            ]);
          });

          const wb = XLSX.utils.book_new();
          const ws = XLSX.utils.aoa_to_sheet(wsData);
          ws['!cols'] = [
            { wch: 12 }, { wch: 10 }, { wch: 28 }, { wch: 40 },
            { wch: 28 }, { wch: 20 }, { wch: 30 }, { wch: 15 },
            { wch: 14 }, { wch: 10 }, { wch: 40 }, { wch: 20 }
          ];
          rows.forEach((row, i) => {
            const rowNum = i + 2;
            if (row.fotoHewan && row.fotoHewan.startsWith('http')) {
              const cellRef = XLSX.utils.encode_cell({ r: rowNum - 1, c: 3 });
              ws[cellRef] = { v: row.fotoHewan, l: { Target: row.fotoHewan, Tooltip: "Lihat foto hewan" } };
            }
            if (row.bukti && row.bukti.startsWith('http')) {
              const cellRef = XLSX.utils.encode_cell({ r: rowNum - 1, c: 10 });
              ws[cellRef] = { v: row.bukti, l: { Target: row.bukti, Tooltip: "Lihat bukti pengiriman" } };
            }
          });
          XLSX.utils.book_append_sheet(wb, ws, "Snapshot Qurban");
          const now = new Date();
          const ts = `${now.getFullYear()}${String(now.getMonth()+1).padStart(2,'0')}${String(now.getDate()).padStart(2,'0')}_${String(now.getHours()).padStart(2,'0')}${String(now.getMinutes()).padStart(2,'0')}`;
          XLSX.writeFile(wb, `snapshot_qurban_${ts}.xlsx`);
        } catch (err) {
          alert("Gagal download Excel: " + err.message);
        } finally {
          if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-file-excel me-1"></i> Download Snapshot Excel'; }
        }
      }
    </script>
  </body>
</html>
